# =============================================================================
# AI GGBond Skills - 统一环境变量配置模板
# =============================================================================
# 使用说明：
#   1. 复制此文件到 ~/.ai-ggbond-skills/.env (用户级配置 - 推荐)
#   2. 或使用交互式配置向导: python scripts/config_loader.py
#   3. 填入你的实际 API Keys 和配置值
#   4. 配置加载优先级: 系统环境变量 > 项目级 > 用户级 > 技能目录
#
# 注意：此文件包含敏感信息，请勿提交到 Git！
# =============================================================================


# =============================================================================
# 一、通用 AI API 配置（多个技能共用）
# =============================================================================

# ---------------------------------------
# 云雾 API (Yunwu) - 图片生成类技能必需
# 技能: wechat-sticker-creator, ai-ggbond-article-writer, marketing-image-generator
# 获取地址: https://yunwu.ai
# ---------------------------------------
YUNWU_API_KEY=your-yunwu-api-key-here
YUNWU_BASE_URL=https://yunwu.ai
# 可选模型: gemini-3.1-flash-image-preview, qwen-image-max, dall-e-3, flux-1.1-pro, gpt-image-1, ideogram-3.0
YUNWU_DEFAULT_MODEL=gemini-3.1-flash-image-preview
YUNWU_IMAGE_MODEL=gpt-image-1
YUNWU_IMAGE_QUALITY=standard

# ---------------------------------------
# OpenAI API - 文本生成类技能
# 获取地址: https://platform.openai.com
# ---------------------------------------
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------
# Google/Gemini API
# 获取地址: https://makersuite.google.com/app/apikey
# ---------------------------------------
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# ---------------------------------------
# 阿里云通义万象 (DashScope)
# 获取地址: https://dashscope.aliyun.com
# ---------------------------------------
DASHSCOPE_API_KEY=sk-your-dashscope-key-here


# =============================================================================
# 二、微信公众号配置
# 技能: baoyu-post-to-wechat, ai-ggbond-wechat-writer-lite
# 获取地址: https://mp.weixin.qq.com -> 开发 -> 基本配置
# =============================================================================
WECHAT_APP_ID=wx_your-app-id-here
WECHAT_APP_SECRET=your-app-secret-here


# =============================================================================
# 三、X (Twitter) 配置
# 技能: baoyu-post-to-x
# =============================================================================
X_API_KEY=your-x-api-key
X_API_SECRET=your-x-api-secret
X_ACCESS_TOKEN=your-x-access-token
X_ACCESS_TOKEN_SECRET=your-x-access-token-secret
X_BEARER_TOKEN=your-x-bearer-token

# X 转 Markdown 工具认证 (可选)
X_AUTH_TOKEN=your-x-auth-token
X_CT0=your-x-ct0-cookie


# =============================================================================
# 四、搜索服务配置
# =============================================================================

# ---------------------------------------
# Tavily API - AI 搜索
# 技能: tavily-search
# 获取地址: https://tavily.com
# ---------------------------------------
TAVILY_API_KEY=tvly-your-tavily-key

# ---------------------------------------
# SearxNG 自建搜索
# 技能: ask-search-master
# ---------------------------------------
SEARXNG_URL=http://localhost:8080
SEARXNG_SECRET_KEY=your-searxng-secret


# =============================================================================
# 五、视频生成配置
# =============================================================================

# ---------------------------------------
# Seedance (字节跳动) - AI 视频生成
# 技能: seedance-video
# 获取地址: https://seedance.io
# ---------------------------------------
SEEDANCE_API_KEY=your-seedance-api-key
SEEDANCE_BASE_URL=https://api.seedance.io


# =============================================================================
# 六、Notion 配置
# 技能: notion
# 获取地址: https://www.notion.so/my-integrations
# =============================================================================
NOTION_API_KEY=secret_your-notion-key
NOTION_DATABASE_ID=your-database-id


# =============================================================================
# 七、浏览器自动化配置（可选）
# 技能: baoyu-post-to-x, baoyu-post-to-wechat
# =============================================================================

# Chrome 浏览器路径（如果不在系统 PATH 中）
X_BROWSER_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
WECHAT_BROWSER_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# 浏览器调试端口（可选，默认 9222）
X_BROWSER_DEBUG_PORT=9222
WECHAT_BROWSER_DEBUG_PORT=9222

# 浏览器配置文件目录（可选）
X_BROWSER_PROFILE_DIR=%USERPROFILE%\.local\share\x-browser-profile
WECHAT_BROWSER_PROFILE_DIR=%USERPROFILE%\.local\share\wechat-browser-profile


# =============================================================================
# 八、技能特定配置（可选）
# =============================================================================

# ---------------------------------------
# 微信贴图生成器 (wechat-sticker-creator)
# ---------------------------------------
WECHAT_STICKER_OUTPUT_DIR=./wechat_stickers
WECHAT_STICKER_WATERMARK=AI朱朱侠
WECHAT_STICKER_RATIO=16:9
WECHAT_STICKER_STYLE=vintage-journal

# ---------------------------------------
# 文章撰写助手 (ai-ggbond-article-writer)
# ---------------------------------------
ARTICLE_OUTPUT_DIR=./articles
SECTION_IMAGE_OUTPUT_DIR=./outputs/section-images
SECTION_IMAGE_SIZE=1792x1024
SECTION_IMAGE_MODEL=gemini-3.1-flash-image-preview

# ---------------------------------------
# 营销图片生成器 (marketing-image-generator)
# ---------------------------------------
MARKETING_IMAGE_OUTPUT_DIR=./marketing_images

# ---------------------------------------
# Agent Reach - 互联网能力扩展
# ---------------------------------------
REDDIT_PROXY=http://proxy.example.com:8080
BILIBILI_PROXY=http://proxy.example.com:8080


# =============================================================================
# 九、代理配置（如果需要）
# =============================================================================
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1


# =============================================================================
# 配置完成！保存后重新加载技能即可生效
# =============================================================================
