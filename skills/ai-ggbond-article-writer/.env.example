# 云雾API配置
# 获取API Key: https://yunwu.ai
YUNWU_API_KEY=sk-xxxxx

# API基础地址（可选，默认自动在多节点间切换）
# 主站: https://yunwu.ai
# 国内服务器: https://api3.wai.vip
# CF站: https://api.apiplus.org
YUNWU_BASE_URL=https://yunwu.ai

# 默认生图模型（可选）
# 支持: gpt-image-2, gpt-image-1, dall-e-3, qwen-image-max, flux-1.1-pro, gemini-3.1-flash-image-preview, ideogram-3.0
# gpt-image-2 使用 OpenAI Images API (/v1/images/generations)，中文渲染效果最佳
YUNWU_DEFAULT_MODEL=gpt-image-2
