# 云雾API配置
# 获取API Key: https://yunwu.ai
YUNWU_API_KEY=sk-xxxxx

# API基础地址（可选，默认自动在多节点间切换）
# 主站: https://yunwu.ai
# 国内服务器: https://api3.wai.vip
# CF站: https://api.apiplus.org
YUNWU_BASE_URL=https://yunwu.ai

# 默认生图模型（可选）
# 支持: gemini-3.1-flash-image-preview, qwen-image-max, dall-e-3, flux-1.1-pro, gpt-image-1, ideogram-3.0
YUNWU_DEFAULT_MODEL=gemini-3.1-flash-image-preview
