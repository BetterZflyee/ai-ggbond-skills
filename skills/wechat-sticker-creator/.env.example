# AI GGBond Skills - 微信贴图生成器环境变量配置示例
# 复制此文件到 ~/.ai-ggbond-skills/.env 或 ./.ai-ggbond-skills/.env

# ============================================
# 必填配置
# ============================================

# 云雾 API 密钥（用于图片生成）
# 获取地址: https://yunwu.ai
YUNWU_API_KEY=your-api-key-here

# 云雾 API 基础 URL
YUNWU_BASE_URL=https://yunwu.ai

# ============================================
# 可选配置
# ============================================

# 默认模型配置
# 可选值:
#   - gpt-image-1 (推荐，中文支持好)
#   - gemini-3.1-flash-image-preview (高质量)
#   - gemini-2.5-flash-image (快速)
#   - qwen-image-edit-2509 (阿里万相，中文优化)
#   - dall-e-3 (OpenAI)
#   - flux-1.1-pro (高质量快速)
YUNWU_DEFAULT_MODEL=gemini-3.1-flash-image-preview

# 输出目录（覆盖默认的 ./wechat_stickers/）
# WECHAT_STICKER_OUTPUT_DIR=./my-stickers

# 默认水印文字（生成图片时自动添加）
# WECHAT_STICKER_WATERMARK=你的品牌名

# 默认图片比例
# 可选值: 1:1 | 16:9 | 3:4
WECHAT_STICKER_RATIO=16:9

# 默认信息图风格
# 可选值:
#   - high-density (高密度信息大图)
#   - retro-pop (复古波普网格)
#   - folder (文件夹/档案风格)
#   - receipt (打印热敏纸风格)
#   - vintage-journal (复古手帐风格)
#   - vector-illustration (矢量插图风格)
WECHAT_STICKER_STYLE=vintage-journal
