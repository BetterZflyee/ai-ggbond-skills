# 云雾API配置
# 获取API Key: https://yunwu.ai
YUNWU_API_KEY=sk-xxxxx

# API基础地址（可选，默认使用主站）
# 国内访问推荐: https://yunwu.zeabur.app/v1
# 国外访问推荐: https://yunwu.ai/v1
YUNWU_BASE_URL=https://yunwu.ai/v1

# 默认生图模型（可选）
# 支持: dall-e-3, flux-1.1-pro, gpt-image-1, ideogram-3.0, qwen-image-edit-2509
# 微信贴图推荐使用 qwen-image-edit-2509，中文支持最好
YUNWU_DEFAULT_MODEL=qwen-image-edit-2509

# 水印文字（可选，留空则不添加水印）
# WATERMARK_TEXT=你的水印
